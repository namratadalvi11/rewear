<%- include('/partials/head') %>

<div class="wrap page-head">
  <p class="eyebrow">Trust on ReWear</p>
  <h1>Reviews</h1>
  <p class="lede">Reviews can only be written after a transaction has actually been completed on the
    platform, which is what makes them worth reading.</p>
  <% if (rating.n) { %>
    <p class="row"><span class="badge badge-gold" style="font-size:.9rem;padding:7px 14px">
      <%= stars(rating.avg) %> <%= rating.avg %> from <%= rating.n %> review<%= rating.n === 1 ? '' : 's' %>
    </span></p>
  <% } %>
</div>

<div class="wrap">
  <!-- ---------- reviews waiting to be written ---------- -->
  <% if (pending.length) { %>
    <div class="panel mb">
      <div class="panel-head"><h2 style="font-size:1.2rem">Waiting for your review</h2></div>
      <% pending.forEach((p) => { %>
        <form method="post" action="/reviews" class="record" data-stars>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="<%= p.kind === 'rental' ? 'rental_id' : 'request_id' %>" value="<%= p.id %>">

          <div class="row row-between mb">
            <div>
              <strong><%= p.title %></strong>
              <div class="s muted">with <a href="/users/<%= p.other_id %>"><%= p.other_name %></a>
                &middot; <%= p.kind === 'rental' ? 'rental' : 'resale / donation' %></div>
            </div>
            <span class="stars stars-out">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
          </div>

          <div class="field">
            <label>Rating</label>
            <div class="chips">
              <% [1,2,3,4,5].forEach((n) => { %>
                <label class="chip"><input type="radio" name="rating" value="<%= n %>"
                  <%= n === 5 ? 'checked' : '' %> required> <%= n %></label>
              <% }) %>
            </div>
          </div>

          <div class="field">
            <label>What went well? <span class="muted">(optional)</span></label>
            <div class="chips">
              <% REVIEW_TAGS.forEach((t) => { %>
                <label class="chip"><input type="checkbox" name="tags" value="<%= t %>"> <%= t %></label>
              <% }) %>
            </div>
          </div>

          <div class="field">
            <label for="c<%= p.kind %><%= p.id %>">Comment</label>
            <textarea id="c<%= p.kind %><%= p.id %>" name="comment" rows="2" style="min-height:70px"
                      placeholder="Was the item as described? Was the handover smooth?"></textarea>
          </div>

          <button class="btn btn-sm" type="submit">Submit review</button>
        </form>
      <% }) %>
    </div>
  <% } %>

  <div class="dash-grid">
    <!-- ---------- received ---------- -->
    <div class="panel">
      <div class="panel-head"><h2 style="font-size:1.2rem">About you</h2></div>
      <% if (received.length) { %>
        <% received.forEach((r) => { %>
          <div class="mini" style="align-items:flex-start">
            <div>
              <div class="t"><%= r.reviewer_name %> <span class="stars"><%= stars(r.rating) %></span></div>
              <% if (r.item_title) { %><div class="s muted">about <%= r.item_title %></div><% } %>
              <% if (r.comment) { %><p class="soft" style="margin:6px 0">&ldquo;<%= r.comment %>&rdquo;</p><% } %>
              <div class="row" style="gap:6px">
                <% json(r.tags, []).forEach((t) => { %><span class="badge"><%= t %></span><% }) %>
              </div>
            </div>
            <div class="end s muted"><%= prettyDate(r.created_at.slice(0, 10)) %></div>
          </div>
        <% }) %>
      <% } else { %>
        <p class="muted" style="margin:0">No reviews about you yet. They arrive after your first
          completed rental or handover.</p>
      <% } %>
    </div>

    <!-- ---------- given ---------- -->
    <div class="panel">
      <div class="panel-head"><h2 style="font-size:1.2rem">Written by you</h2></div>
      <% if (given.length) { %>
        <% given.forEach((r) => { %>
          <div class="mini" style="align-items:flex-start">
            <div>
              <div class="t"><%= r.reviewee_name %> <span class="stars"><%= stars(r.rating) %></span></div>
              <% if (r.item_title) { %><div class="s muted">about <%= r.item_title %></div><% } %>
              <% if (r.comment) { %><p class="soft" style="margin:6px 0">&ldquo;<%= r.comment %>&rdquo;</p><% } %>
            </div>
            <div class="end s muted"><%= prettyDate(r.created_at.slice(0, 10)) %></div>
          </div>
        <% }) %>
      <% } else { %>
        <p class="muted" style="margin:0">You haven&rsquo;t written any reviews yet.</p>
      <% } %>
    </div>
  </div>
</div>

<%- include('/partials/foot') %>
