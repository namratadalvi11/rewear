<%# Pagination. Locals: page, pages, query, basePath %>
<% if (pages > 1) {
     const link = (n) => {
       const p = new URLSearchParams(query);
       p.set('page', n);
       return basePath + '?' + p.toString();
     };
     const from = Math.max(1, page - 2), to = Math.min(pages, page + 2);
%>
<nav class="pager" aria-label="Pagination">
  <% if (page > 1) { %><a href="<%= link(page - 1) %>" rel="prev">Prev</a><% } %>
  <% if (from > 1) { %><a href="<%= link(1) %>">1</a><% if (from > 2) { %><span>…</span><% } %><% } %>
  <% for (let n = from; n <= to; n++) { %>
    <% if (n === page) { %><span class="on" aria-current="page"><%= n %></span>
    <% } else { %><a href="<%= link(n) %>"><%= n %></a><% } %>
  <% } %>
  <% if (to < pages) { %><% if (to < pages - 1) { %><span>…</span><% } %><a href="<%= link(pages) %>"><%= pages %></a><% } %>
  <% if (page < pages) { %><a href="<%= link(page + 1) %>" rel="next">Next</a><% } %>
</nav>
<% } %>
