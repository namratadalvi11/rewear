<%- include('/partials/head') %>
<%
  const basePath = mode === 'sell' ? '/resale' : (mode === 'all' ? '/explore' : '/browse');
  // Chips describing the filters currently applied, each one removable.
  const FILTER_LABELS = { q: 'Search', category: 'Category', gender: 'For', occasion: 'Occasion',
    size: 'Size', condition: 'Condition', brand: 'Brand', location: 'Locality', min_price: 'Min',
    max_price: 'Max', from: 'From', to: 'Until' };
  const applied = Object.keys(FILTER_LABELS).filter((k) => query[k]);
  const without = (key) => {
    const p = new URLSearchParams(query); p.delete(key); p.delete('page');
    const s = p.toString();
    return basePath + (s ? '?' + s : '');
  };
%>

<div class="wrap page-head collection-head">
  <p class="eyebrow"><%= mode === 'sell' ? 'Resale Hub' : 'Community Wardrobe' %></p>
  <h1><%= heading %></h1>
  <p class="lede"><%= sub %></p>
</div>

<div class="wrap collection-tools">
  <form class="searchbar collection-search" method="get" action="<%= basePath %>" role="search">
    <% ['category','gender','occasion','size','condition','brand','location','min_price','max_price','from','to','sort'].forEach((k) => { %>
      <% if (query[k]) { %><input type="hidden" name="<%= k %>" value="<%= query[k] %>"><% } %>
    <% }) %>
    <label class="sr-only" for="q">Search clothes</label>
    <input type="search" id="q" name="q" value="<%= query.q || '' %>"
           placeholder="Search by item, category, occasion or style&hellip;">
    <button class="btn" type="submit">Search</button>
  </form>
  <%- include('/partials/collection-tabs', { mode: mode }) %>
</div>

<div class="wrap">
  <div class="browse collection-browse">
    <details class="collection-filter-wrap" open>
      <summary>Filter collection</summary>
      <%- include('/partials/filters') %>
    </details>

    <div class="collection-results">
      <div class="result-bar">
        <p class="muted" style="margin:0">
          <strong><%= total %></strong> item<%= total === 1 ? '' : 's' %> found
          <% if (query.q) { %> for &ldquo;<%= query.q %>&rdquo;<% } %>
        </p>
        <form method="get" action="<%= basePath %>">
          <% Object.keys(query).forEach((k) => { %>
            <% if (k !== 'sort' && k !== 'page' && query[k]) { %>
              <input type="hidden" name="<%= k %>" value="<%= query[k] %>">
            <% } %>
          <% }) %>
          <label class="sr-only" for="sort">Sort by</label>
          <select id="sort" name="sort" data-autosubmit>
            <option value="newest" <%= query.sort === 'newest' || !query.sort ? 'selected' : '' %>>Newest</option>
            <option value="price_asc" <%= query.sort === 'price_asc' ? 'selected' : '' %>>Price: low to high</option>
            <option value="price_desc" <%= query.sort === 'price_desc' ? 'selected' : '' %>>Price: high to low</option>
            <option value="most_rented" <%= query.sort === 'most_rented' ? 'selected' : '' %>>Most rented</option>
            <option value="rating" <%= query.sort === 'rating' ? 'selected' : '' %>>Highest rated owner</option>
          </select>
          <noscript><button class="btn btn-quiet btn-sm" type="submit">Sort</button></noscript>
        </form>
      </div>

      <% if (applied.length) { %>
        <div class="active-filters">
          <% applied.forEach((k) => { %>
            <a class="chip" href="<%= without(k) %>">
              <%= FILTER_LABELS[k] %>: <strong><%= query[k] %></strong> <span aria-hidden="true">&times;</span>
              <span class="sr-only">Remove filter</span>
            </a>
          <% }) %>
          <a class="chip" href="<%= basePath %>">Clear all</a>
        </div>
      <% } %>

      <% if (items.length) { %>
        <div class="grid grid-cards">
          <% items.forEach((item) => { %>
            <%- include('/partials/item-card', { item: item, mode: mode }) %>
          <% }) %>
        </div>
        <%- include('/partials/pager', { page: page, pages: pages, query: query, basePath: basePath }) %>
      <% } else { %>
        <%- include('/partials/empty', {
          heading: 'Nothing matches those filters yet.',
          text: 'Try widening the dates, clearing a filter, or checking back soon. New items are added by members every week.',
          cta: 'Clear filters', href: basePath }) %>
      <% } %>
    </div>
  </div>
</div>

<%- include('/partials/foot') %>
