<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>ReWear – Style with a Longer Story</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400&family=Playfair+Display:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css?v=20261015-hero-clean">
<link rel="stylesheet" href="/css/home-fixes.css?v=3">
</head>
<body>
<header class="hero" id="home">
  <nav class="nav">
    <a href="#home" class="logo">ReWear</a>
    <ul class="menu">
      <li><a class="active" href="#home">Home</a></li>
      <li><a href="/browse">Rent</a></li>
      <li><a href="/resale">Resale</a></li>
      <li><a href="/donate">Donate</a></li>
      <li><a href="/about">About</a></li>
    </ul>
    <div class="icons">
      <a href="/browse" aria-label="Search clothes"><svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="M21 21l-5-5"/></svg></a>
      <a href="<%= user ? '/profile' : '/login' %>" aria-label="Account"><svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/></svg></a>
      <a href="<%= user ? '/wishlist' : '/login' %>" aria-label="Wishlist" id="wish"><svg viewBox="0 0 24 24"><path d="M12 21s-8-5.5-8-11a4.5 4.5 0 018-2.5A4.5 4.5 0 0120 10c0 5.5-8 11-8 11z"/></svg></a>
      <a href="<%= user ? '/cart' : '/login' %>" aria-label="Rental cart"><svg viewBox="0 0 24 24"><path d="M5 8h14l-1 13H6zM9 8V6a3 3 0 016 0v2"/></svg></a>
    </div>
  </nav>
  <h1 class="big">REWEAR</h1>
  <div class="model"></div>
  <div class="tag-left">
    <p class="script">Rent. Resale. Donate.</p>
    <span class="rule"></span>
    <p>Give your clothes<br>a longer story.</p>
  </div>
  <p class="tag-right">Sustainable fashion<br>for a kinder planet<br>and a more stylish you.</p>
  <div class="features">
    <div><svg viewBox="0 0 24 24"><path d="M5 19C5 9 12 4 20 4c0 9-5 15-15 15zM5 19L14 10"/></svg><span><b>Eco Friendly</b><small>Reduce waste</small></span></div>
    <div><svg viewBox="0 0 24 24"><path d="M12 21s-8-5.500-8-11a4.500 4.500 0 018-2.500A4.500 4.500 0 0120 10c0 5.5-8 11-8 11z"/></svg><span><b>Pre-Loved Resale</b><small>Extend life</small></span></div>
    <div><svg viewBox="0 0 24 24"><rect x="3" y="8" width="18" height="4"/><path d="M5 12v9h14v-9M12 8v13M12 8c-4 0-5-5-2-5s2 5 2 5zm0 0c4 0 5-5 2-5s-2 5-2 5z"/></svg><span><b>Earn & Donate</b><small>Give back</small></span></div>
    <div><svg viewBox="0 0 24 24"><path d="M20 12a8 8 0 00-14-5M4 12a8 8 0 0014 5M6 3v4h4M18 21v-4h-4"/></svg><span><b>Circular Care</b><small>Professionally cleaned</small></span></div>
  </div>
</header>

<main>
<section class="cats" id="rent">
  <p class="eyebrow"><i></i>SHOP BY CATEGORY<i></i></p>
  <h2>Find Your Perfect Fit</h2>
  <p class="sub">Browse rental, resale, and donation collections curated<br>for every mood, moment and occasion.</p>
  <div class="grid4">
    <a href="/browse?gender=Women" class="card c1"><span>Women</span><em>→</em></a>
    <a href="/browse?gender=Men" class="card c2"><span>Men</span><em>→</em></a>
    <a href="/browse?category=Accessories" class="card c3"><span>Accessories</span><em>→</em></a>
    <a href="/browse?occasion=Wedding" class="card c4"><span>Occasions</span><em>→</em></a>
  </div>
</section>

<section class="story" id="story">
  <div class="rack"></div>
  <div class="story-text">
    <p class="eyebrow"><i></i>OUR STORY<i></i></p>
    <h2>More Than Renting</h2>
    <p>We're building a community that values<br>style, sustainability and second chances.<br>Because great fashion isn't just about what you wear,<br>it's about what you do with it.</p>
    <a href="/about" class="btn">Learn More <span>→</span></a>
  </div>
</section>

<section class="trend" id="resale">
  <div class="trend-head">
    <p class="eyebrow dark"><i></i>FEATURED COLLECTIONS<i></i></p>
    <h2>Trending Rentals</h2>
    <a href="/browse" class="viewall">View All <span>→</span></a>
  </div>
  <% if (featured.length) { %>
    <div class="trend-grid">
      <% featured.slice(0, 4).forEach((item) => { %>
        <a class="trend-card" href="/items/<%= item.id %>" aria-label="View featured rental: <%= item.title %>">
          <span class="trend-img" style="background-image:url('<%= itemImage(item) %>')" aria-hidden="true"></span>
          <span class="trend-info">
            <span class="trend-title"><%= item.title %></span>
            <span class="trend-meta"><%= item.category %> &middot; Size <%= item.size === 'Custom Measurements' ? 'Custom' : item.size %></span>
            <span class="trend-price"><%= money(item.rental_price) %> <small>/ day</small></span>
          </span>
        </a>
      <% }) %>
    </div>
  <% } else { %>
    <p class="sub">No rentals are listed yet. <a href="<%= user ? '/items/new' : '/register' %>">Be the first to list one.</a></p>
  <% } %>
</section>
</main>

<script src="/js/main.js?v=20261015-home-header"></script>
</body>
</html>
